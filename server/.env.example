# Optional. Defaults to 8787. Railway/Render set this automatically — leave it unset there.
PORT=8787

# Optional. Comma-separated list of allowed origins for cross-origin requests, e.g. your Vercel frontend's URL:
#   CORS_ORIGIN=https://your-app.vercel.app
# Only needed when the frontend is deployed as a separate service from this server. Leave unset to allow any
# origin (fine here — there's no cookie/session auth on this API to leak cross-origin).
CORS_ORIGIN=
