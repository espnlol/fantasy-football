# Leave unset for local dev — Vite's dev-server proxy (vite.config.ts) forwards /api to the
# Express server on the same origin.
#
# Set this in Vercel's project env vars when the frontend is deployed separately from the
# backend (e.g. frontend on Vercel, backend on Railway/Render): the full base URL of that
# backend, no trailing slash.
#   VITE_API_BASE_URL=https://your-backend.up.railway.app
VITE_API_BASE_URL=
